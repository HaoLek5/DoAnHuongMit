APP_NAME="Hương Mít"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.com

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=haomilk_staging
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Reverse proxy whitelist (vd: 127.0.0.1 hoặc dải IP Nginx/Cloudflare)
TRUSTED_PROXIES=127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Google Gemini AI Integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VERIFY_SSL=true

# Bank Transfer / VietQR / SePay Configuration (điền secret thật trên server, tuyệt đối không commit)
BANK_ID=MB
BANK_NAME="Ngân hàng Quân Đội (MB Bank)"
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME="CUA HANG HUONG MIT"
BANK_QR_TEMPLATE=compact2
BANK_PAYMENT_EXPIRY_MINUTES=10
PAYMENT_WEBHOOK_TOKEN=
PAYMENT_WEBHOOK_HMAC_SECRET=

