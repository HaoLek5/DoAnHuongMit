APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Reverse proxy IP whitelist (VD: 127.0.0.1 hoặc CIDR proxy)
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Queue Configuration (Dùng 'sync' nếu hosting không hỗ trợ daemon queue worker, hoặc 'database' nếu dùng cron worker)
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email SMTP Configuration (AZDIGI cPanel / Gmail SMTP)
# Đối với AZDIGI cPanel: MAIL_HOST=mail.huongmit.shop, MAIL_PORT=465, MAIL_ENCRYPTION=ssl
# Đối với Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls (dùng App Password)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.huongmit.shop
MAIL_PORT=465
MAIL_USERNAME=noreply@huongmit.shop
MAIL_PASSWORD=your_mail_password_here
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@huongmit.shop"
MAIL_FROM_NAME="Hương Mít"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Gemini AI Integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VERIFY_SSL=true


# Bank Transfer / VietQR & SePay Webhook Configuration
# Cấu hình tài khoản ngân hàng nhận tiền hiển thị trên VietQR
BANK_ID=MB
BANK_NAME="Ngân hàng Quân Đội (MB Bank)"
BANK_ACCOUNT_NO=your_bank_account_number
BANK_ACCOUNT_NAME="CUA HANG HUONG MIT"
BANK_QR_TEMPLATE=compact2
BANK_PAYMENT_EXPIRY_MINUTES=10

# SePay Webhook Authentication (API Key hoặc HMAC-SHA256)
# PAYMENT_WEBHOOK_TOKEN: Khớp với API Key trên dashboard SePay (gửi qua Header Authorization hoặc X-Api-Key)
PAYMENT_WEBHOOK_TOKEN=your_sepay_api_key_here
# PAYMENT_WEBHOOK_HMAC_SECRET: Để trống nếu SePay chỉ dùng API Key. Điền secret nếu bật HMAC-SHA256.
PAYMENT_WEBHOOK_HMAC_SECRET=
